[Unit]
Description=Real-time jitter monitor daemon (rtmonitord)
After=multi-user.target

[Service]
Type=simple

# Create /run/rtmonitord/ at start. Tmp dir
RuntimeDirectory=rtmonitord
RuntimeDirectoryMode=0755

# Start the daemon (journald captures stdout/stderr)
ExecStart=/usr/local/bin/rtmonitord --rate 1000 --policy rr --prio 80 --mlock --pidfile /run/rtmonitord/rtmonitord.pid --stats-out /run/rtmonitord/rtmonitord.stats

# Restart on crash
Restart=on-failure
RestartSec=0.2

# Send SIGTERM on stop (daemon handles SIGTERM)
KillSignal=SIGTERM
TimeoutStopSec=2

# Easiest for RT scheduling/locking memory. Run as root.
User=root

# Simple Security for now
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
